+import { describe, expect, it } from 'vitest'
+import { parseWritingSource, WritingValidationError } from './schema'
+
+function source(body: string) {
+  return `---
+title: "Conditional section"
+description: "Fixture"
+format: article
+draft: true
+readerLanguages:
+  - csharp
+  - java
+  - python
+defaultReaderLanguage: csharp
+---
+
+${body}
+`
+}
+
+describe('language-only authoring', () => {
+  it('parses a language subset and associates its headings with that subset', () => {
+    const writing = parseWritingSource({
+      path: 'src/content/writings/drafts/conditional-section.md',
+      source: source(`
+## Shared section
+
+Shared prose.
+
+::::language-only python
+
+## Python detail
+
+Python-only prose.
+
+::::
+
+## Shared ending
+
+Done.
+`),
+    })
+
+    expect(writing.segments.map(({ type }) => type)).toEqual([
+      'markdown',
+      'language-only',
+      'markdown',
+    ])
+    const conditional = writing.segments[1]
+    expect(conditional.type).toBe('language-only')
+    if (conditional.type !== 'language-only') return
+    expect(conditional.languages).toEqual(['python'])
+    expect(conditional.headingTexts).toEqual(['Python detail'])
+    expect(writing.headings).toEqual([
+      { depth: 2, id: 'shared-section', text: 'Shared section' },
+      { depth: 2, id: 'python-detail', text: 'Python detail', languages: ['python'] },
+      { depth: 2, id: 'shared-ending', text: 'Shared ending' },
+    ])
+  })
+
+  it('supports more than one declared reader language', () => {
+    const writing = parseWritingSource({
+      path: 'src/content/writings/drafts/conditional-section.md',
+      source: source(`::::language-only csharp java
+
+## Static languages
+
+Only C# and Java see this section.
+
+::::`),
+    })
+    const conditional = writing.segments[0]
+    expect(conditional.type).toBe('language-only')
+    if (conditional.type !== 'language-only') return
+    expect(conditional.languages).toEqual(['csharp', 'java'])
+  })
+
+  it.each([
+    ['missing arguments', '::::language-only\nText\n::::'],
+    ['unknown language', '::::language-only ruby\nText\n::::'],
+    ['duplicate language', '::::language-only python python\nText\n::::'],
+  ])('rejects %s', (_name, body) => {
+    expect(() =>
+      parseWritingSource({
+        path: 'src/content/writings/drafts/conditional-section.md',
+        source: source(body),
+      }),
+    ).toThrowError(WritingValidationError)
+  })
+
+  it('rejects nested framework directives', () => {
+    expect(() =>
+      parseWritingSource({
+        path: 'src/content/writings/drafts/conditional-section.md',
+        source: source(`::::language-only python
+:::code-tabs
+\`\`\`python
+print("no")
+\`\`\`
+:::
+::::`),
+      }),
+    ).toThrowError(WritingValidationError)
+  })
+})

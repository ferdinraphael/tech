+import { render, screen, within } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { describe, expect, it } from 'vitest'
+import type { WritingSegment } from '../../content/writings/types'
+import { LanguagePreferenceProvider } from './LanguagePreference'
+import { MarkdownWriting } from './MarkdownWriting'
+
+const segments: WritingSegment[] = [
+  { type: 'markdown', source: '## Shared section\n\nShared prose.' },
+  {
+    type: 'language-only',
+    languages: ['python'],
+    source: '## Python detail\n\nPython-only prose.',
+    headingTexts: ['Python detail'],
+  },
+  { type: 'markdown', source: '## Shared ending\n\nDone.' },
+]
+
+function renderWriting() {
+  return render(
+    <LanguagePreferenceProvider
+      readerLanguages={['csharp', 'java', 'python']}
+      defaultReaderLanguage="csharp"
+    >
+      <MarkdownWriting segments={segments} />
+    </LanguagePreferenceProvider>,
+  )
+}
+
+describe('language-only rendering', () => {
+  it('hides a Python-only section in C# and shows it when Python is selected', async () => {
+    const user = userEvent.setup()
+    renderWriting()
+
+    expect(screen.getByRole('heading', { name: 'Shared section' })).toBeInTheDocument()
+    expect(screen.queryByRole('heading', { name: 'Python detail' })).not.toBeInTheDocument()
+
+    await user.click(screen.getByRole('radio', { name: 'Python' }))
+
+    expect(screen.getByRole('heading', { name: 'Python detail' })).toBeInTheDocument()
+    expect(screen.getByText('Python-only prose.')).toBeVisible()
+  })
+
+  it('shows language-only content once and labels it in Compare mode', async () => {
+    const user = userEvent.setup()
+    renderWriting()
+
+    await user.click(screen.getByRole('radio', { name: 'Compare' }))
+
+    expect(screen.getByRole('heading', { name: 'Python detail' })).toBeInTheDocument()
+    expect(screen.getByText('Python')).toBeInTheDocument()
+    expect(screen.getAllByText('Python-only prose.')).toHaveLength(1)
+  })
+})

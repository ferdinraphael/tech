{
  "name": "ferdinraphael-tech",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "content:check": "vitest run src/content/writings/content-check.test.ts --configLoader runner --pool=threads --maxWorkers=1",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src tests scripts vite.config.ts playwright.config.ts",
    "test": "vitest run --configLoader runner --pool=threads --maxWorkers=1",
    "test:watch": "vitest --configLoader runner --pool=threads --maxWorkers=1",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "test:writings-preview": "node scripts/run-e2e.mjs --writings-preview",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.545.0",
    "marked": "^16.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "oxlint": "^1.75.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
